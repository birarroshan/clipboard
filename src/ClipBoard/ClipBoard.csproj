<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ClipStack</AssemblyName>
    <RootNamespace>ClipBoard</RootNamespace>
    <Product>ClipStack</Product>
    <Title>ClipStack</Title>
    <Description>ClipStack searchable clipboard history</Description>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/branding/ClipStack.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/branding/ClipStack.ico" LogicalName="ClipStack.ico" />
    <ProjectReference Include="../ClipBoard.Core/ClipBoard.Core.csproj" />
    <InternalsVisibleTo Include="ClipBoard.Tests" />
  </ItemGroup>
</Project>